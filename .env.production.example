# ─── XN CRM production environment ──────────────────────────────────────
# Copy to .env.production (never commit it) and replace every value.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

APP_VERSION=1.0.0
API_PORT=3000
PORT=3000
LOG_LEVEL=info
# Explicit origins only ("*" is rejected in production).
CORS_ORIGIN=https://app.example.uz
# Behind a reverse proxy / load balancer (nginx, Caddy, cloud LB): hop count.
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=15000

# Database (the compose file builds DATABASE_URL from these).
POSTGRES_USER=xn_crm
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=xn_crm

# Redis (the compose file builds REDIS_URL from this).
REDIS_PASSWORD=replace-with-a-long-random-password

# Auth
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url-access
JWT_REFRESH_SECRET=replace-with-48-random-bytes-base64url-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Rate limiting (per client IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Notifications
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_SCAN_INTERVAL_MS=60000
NOTIFICATION_TASK_DUE_HOURS=24
NOTIFICATION_PAYMENT_DUE_DAYS=3
NOTIFICATION_OVERDUE_LOOKBACK_DAYS=7
NOTIFICATION_EMAIL_PROVIDER=none
NOTIFICATION_SMS_PROVIDER=none
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# ─── Management hierarchy ───
# open = anyone signed in may create a center; owner = only the platform owner (/owner/centers)
CENTER_CREATION=owner
# Address shown to the owner for each center (DNS/SSL are managed outside the app)
# CENTER_URL_TEMPLATE=https://{slug}.xn-crm.uz
CENTER_EXPIRY_SCAN_INTERVAL_MS=3600000
CHECKLIST_SCAN_INTERVAL_MS=900000
