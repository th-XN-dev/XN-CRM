# ─── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins, e.g. http://localhost:5173,https://app.xncrm.uz
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults. Never commit real credentials.
DATABASE_URL=postgresql://xn_crm:xn_crm_dev_password@localhost:5432/xn_crm?schema=public

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Duration strings supported by `ms`: 15m, 1h, 30d ...
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Rate limiting (per client IP) ──────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ─── Runtime ────────────────────────────────────────────────────────────
# Behind a reverse proxy set the hop count, e.g. 1 (real client IPs for rate limits and audit).
# TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=15000

# ─── Notifications ──────────────────────────────────────────────────────
# Set to use BullMQ (docker compose starts redis); empty → in-process queue.
REDIS_URL=redis://localhost:6379
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=5000
# 0 disables the due/overdue reminder scanner.
NOTIFICATION_SCAN_INTERVAL_MS=60000
NOTIFICATION_TASK_DUE_HOURS=24
NOTIFICATION_PAYMENT_DUE_DAYS=3
NOTIFICATION_OVERDUE_LOOKBACK_DAYS=7
# none | mock (real providers plug in behind the same interface)
NOTIFICATION_EMAIL_PROVIDER=none
NOTIFICATION_SMS_PROVIDER=none
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=xn_crm_bot
# TELEGRAM_WEBHOOK_SECRET=at-least-16-random-characters

# ─── Management hierarchy ───
# open = anyone signed in may create a center; owner = only the platform owner (/owner/centers)
CENTER_CREATION=open
# Address shown to the owner for each center (DNS/SSL are managed outside the app)
# CENTER_URL_TEMPLATE=https://{slug}.xn-crm.uz
CENTER_EXPIRY_SCAN_INTERVAL_MS=3600000
CHECKLIST_SCAN_INTERVAL_MS=900000
